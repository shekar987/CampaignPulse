# PostgreSQL connection used by Prisma and the API.
# Matches docker-compose.yml, which publishes the container on host port 5433 so it never
# collides with a PostgreSQL service already installed on the machine. To use an existing
# server instead, point this at it, e.g. postgresql://user:password@localhost:5432/campaignpulse
DATABASE_URL=postgresql://campaignpulse:campaignpulse@localhost:5433/campaignpulse

# Optional: a separate database for the integration tests (`npm test`). When unset, tests that
# need PostgreSQL are skipped. The suite wipes this database's tables on every run.
# DATABASE_URL_TEST=postgresql://campaignpulse:campaignpulse@localhost:5433/campaignpulse_test

# HTTP port for the GraphQL API
PORT=4000

# Log level for structured logs: trace | debug | info | warn | error
LOG_LEVEL=info

# development | test | production
NODE_ENV=development

# Message transport: local (in-process, no cloud credentials) or sqs (AWS Lambda deployment)
EVENT_BUS=local

# Where incident and dead-letter notifications go: log (local) or sns (AWS)
NOTIFICATIONS=log

# Concurrent local workers draining the in-process queue
LOCAL_BUS_CONCURRENCY=4

# Multiplier on the retry backoff schedule (5 s, 30 s). 0.1 keeps local demos snappy;
# production uses 1.
RETRY_BACKOFF_SCALE=0.1

# Multiplier on simulated channel latency while a worker waits for an attempt (0-1)
SIMULATION_LATENCY_SCALE=0.05
