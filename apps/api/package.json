{
  "name": "@campaignpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "prisma generate && graphql-codegen --config codegen.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@campaignpulse/event-contracts": "*",
    "@campaignpulse/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.22.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0"
  }
}
