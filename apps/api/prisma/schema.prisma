// CampaignPulse data model.
//
// Column and table names are snake_case in PostgreSQL and camelCase in the client. Health is
// persisted (recalculated whenever delivery events change) while delivery metrics are
// aggregated on read from `delivery_events`. See docs/decisions.md for the reasoning.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Simulated delivery channels. Mirrors CHANNELS in @campaignpulse/event-contracts.
enum Channel {
  WEB
  MOBILE_APP
  IN_STORE_DISPLAY
  SMARTSHOP
}

/// Lifecycle of a campaign, independent of its delivery health.
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// Derived from delivery error rates. UNKNOWN means no delivery data yet.
enum HealthStatus {
  HEALTHY
  DEGRADED
  CRITICAL
  UNKNOWN
}

/// Mirrors EVENT_TYPES in @campaignpulse/event-contracts.
enum EventType {
  CAMPAIGN_DELIVERY_REQUESTED
  DELIVERY_STARTED
  DELIVERY_SUCCEEDED
  DELIVERY_FAILED
  DELIVERY_RETRY_REQUESTED
  DELIVERY_RETRY_SUCCEEDED
  DELIVERY_FINAL_FAILURE
  INCIDENT_CREATED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_RESOLVED
}

/// Mirrors EVENT_STATUSES in @campaignpulse/event-contracts.
enum EventStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
  FINAL_FAILURE
}

/// Mirrors ERROR_CODES in @campaignpulse/event-contracts.
enum ErrorCode {
  TIMEOUT
  RATE_LIMITED
  VALIDATION_ERROR
  DEPENDENCY_UNAVAILABLE
  AUTHORIZATION_ERROR
  NETWORK_ERROR
  UNKNOWN_ERROR
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentSeverity {
  WARNING
  CRITICAL
}

enum DeadLetterReason {
  RETRIES_EXHAUSTED
  NON_RETRYABLE_ERROR
  PROCESSING_FAILURE
}

enum DeadLetterStatus {
  PENDING
  REPLAYED
  DISCARDED
}

model Campaign {
  id             String         @id @default(uuid(7)) @db.Uuid
  name           String         @db.VarChar(255)
  advertiserName String         @map("advertiser_name") @db.VarChar(255)
  status         CampaignStatus @default(ACTIVE)
  healthStatus   HealthStatus   @default(UNKNOWN) @map("health_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  channels          CampaignChannel[]
  events            DeliveryEvent[]
  incidents         Incident[]
  deliveries        Delivery[]
  deadLetterEntries DeadLetterEntry[]

  @@index([healthStatus])
  @@index([createdAt(sort: Desc)])
  @@map("campaigns")
}

/// One row per delivery workflow (correlation id). Holds the current status so transitions can
/// be enforced atomically, and the simulation parameters so retries and replays reuse them.
model Delivery {
  correlationId    String      @id @map("correlation_id") @db.VarChar(255)
  campaignId       String      @map("campaign_id") @db.Uuid
  channel          Channel
  status           EventStatus @default(PENDING)
  attempts         Int         @default(0)
  lastErrorCode    ErrorCode?  @map("last_error_code")
  lastErrorMessage String?     @map("last_error_message")
  simulation       Json?
  requestedAt      DateTime    @map("requested_at") @db.Timestamptz(3)
  completedAt      DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([campaignId, channel, requestedAt(sort: Desc)])
  @@map("deliveries")
}

/// Deliveries that could not be completed: retries exhausted, a non-retryable error, or a
/// message the worker could not process at all. Engineers replay or discard them from the UI.
model DeadLetterEntry {
  id                  String           @id @default(uuid(7)) @db.Uuid
  campaignId          String           @map("campaign_id") @db.Uuid
  correlationId       String           @unique @map("correlation_id") @db.VarChar(255)
  channel             Channel
  attempts            Int
  lastErrorCode       ErrorCode        @map("last_error_code")
  lastErrorMessage    String           @map("last_error_message")
  reason              DeadLetterReason
  payload             Json
  status              DeadLetterStatus @default(PENDING)
  enqueuedAt          DateTime         @map("enqueued_at") @db.Timestamptz(3)
  replayedAt          DateTime?        @map("replayed_at") @db.Timestamptz(3)
  replayCorrelationId String?          @map("replay_correlation_id") @db.VarChar(255)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, enqueuedAt(sort: Desc)])
  @@map("dead_letter_entries")
}

model CampaignChannel {
  id           String       @id @default(uuid(7)) @db.Uuid
  campaignId   String       @map("campaign_id") @db.Uuid
  channel      Channel
  healthStatus HealthStatus @default(UNKNOWN) @map("health_status")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, channel])
  @@map("campaign_channels")
}

/// One row per event on a delivery timeline. `id` is supplied by the producer and doubles as
/// the idempotency key; `correlation_id` links every event of one delivery workflow.
model DeliveryEvent {
  id            String      @id @default(uuid(7)) @db.Uuid
  campaignId    String      @map("campaign_id") @db.Uuid
  correlationId String      @map("correlation_id") @db.VarChar(255)
  eventType     EventType   @map("event_type")
  channel       Channel
  status        EventStatus
  attempt       Int         @default(1)
  latencyMs     Int?        @map("latency_ms")
  errorCode     ErrorCode?  @map("error_code")
  errorMessage  String?     @map("error_message")
  metadata      Json?
  occurredAt    DateTime    @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt(sort: Desc)])
  @@index([correlationId])
  @@index([campaignId, channel, eventType])
  @@index([occurredAt])
  @@map("delivery_events")
}

/// A detected reliability problem on one campaign channel. At most one incident per campaign
/// channel can be unresolved at a time (partial unique index in the migration).
model Incident {
  id                      String           @id @default(uuid(7)) @db.Uuid
  campaignId              String           @map("campaign_id") @db.Uuid
  channel                 Channel
  status                  IncidentStatus   @default(OPEN)
  severity                IncidentSeverity
  title                   String           @db.VarChar(255)
  description             String?
  errorRateAtDetection    Float?           @map("error_rate_at_detection")
  failedEventsAtDetection Int?             @map("failed_events_at_detection")
  totalEventsAtDetection  Int?             @map("total_events_at_detection")
  resolutionNote          String?          @map("resolution_note")
  startedAt               DateTime         @map("started_at") @db.Timestamptz(3)
  acknowledgedAt          DateTime?        @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt              DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, startedAt(sort: Desc)])
  @@map("incidents")
}

/// Idempotency ledger: an event id recorded here has already been processed and must be
/// ignored if it is delivered again.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}
